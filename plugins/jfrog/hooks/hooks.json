{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"./modules/cursor-session-start.mjs\" package-resolution",
        "timeout": 7
      },
      {
        "command": "node \"./scripts/cursor-align-mcp-json.mjs\" session-start",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"./scripts/enforce-skill.mjs\"",
        "timeout": 30,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "node \"./scripts/enforce-skill.mjs\" --prefer-offline",
        "matcher": "Read",
        "timeout": 30,
        "failClosed": false
      }
    ]
  }
}
