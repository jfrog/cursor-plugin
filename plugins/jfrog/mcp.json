{
  "mcpServers": {
    "jfrog": {
      "command": "npx",
      "args": [
        "--yes",
        "--registry", "${JFROG_AGENT_GUARD_REPO:-https://releases.jfrog.io/artifactory/api/npm/coding-agents-npm/}",
        "@jfrog/agent-guard"
      ],
      "env": {
        "_JF_ARGS": "mcp=jfrog-mcp"
      }
    }
  }
}
